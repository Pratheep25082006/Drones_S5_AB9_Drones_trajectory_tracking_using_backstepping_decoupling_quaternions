<?xml version="1.0" ?>
<robot name="quadrotor">
  <!-- Base Link / Center of Mass -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.05"/>
    </inertial>

    <!-- Fuselage Body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.20 0.07"/>
      </geometry>
      <material name="dark_carbon">
        <color rgba="0.15 0.15 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.20 0.07"/>
      </geometry>
    </collision>

    <!-- Canopy Top -->
    <visual>
      <origin xyz="0.02 0 0.04" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="cyan_glass">
        <color rgba="0.1 0.7 0.9 0.85"/>
      </material>
    </visual>

    <!-- Arm 1 (Front-Right) -->
    <visual>
      <origin xyz="0.14 -0.14 0" rpy="0 0 -0.785398"/>
      <geometry>
        <box size="0.28 0.025 0.018"/>
      </geometry>
      <material name="arm_dark">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>

    <!-- Arm 2 (Front-Left) -->
    <visual>
      <origin xyz="0.14 0.14 0" rpy="0 0 0.785398"/>
      <geometry>
        <box size="0.28 0.025 0.018"/>
      </geometry>
      <material name="arm_dark">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>

    <!-- Arm 3 (Rear-Left) -->
    <visual>
      <origin xyz="-0.14 0.14 0" rpy="0 0 -0.785398"/>
      <geometry>
        <box size="0.28 0.025 0.018"/>
      </geometry>
      <material name="arm_dark">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>

    <!-- Arm 4 (Rear-Right) -->
    <visual>
      <origin xyz="-0.14 -0.14 0" rpy="0 0 0.785398"/>
      <geometry>
        <box size="0.28 0.025 0.018"/>
      </geometry>
      <material name="arm_dark">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>

    <!-- Rotor 1 Propeller (Front-Right: +X, -Y) -->
    <visual>
      <origin xyz="0.22 -0.22 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.008"/>
      </geometry>
      <material name="prop_cyan">
        <color rgba="0.0 0.8 1.0 0.7"/>
      </material>
    </visual>

    <!-- Rotor 2 Propeller (Front-Left: +X, +Y) -->
    <visual>
      <origin xyz="0.22 0.22 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.008"/>
      </geometry>
      <material name="prop_cyan">
        <color rgba="0.0 0.8 1.0 0.7"/>
      </material>
    </visual>

    <!-- Rotor 3 Propeller (Rear-Left: -X, +Y) -->
    <visual>
      <origin xyz="-0.22 0.22 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.008"/>
      </geometry>
      <material name="prop_red">
        <color rgba="1.0 0.2 0.2 0.7"/>
      </material>
    </visual>

    <!-- Rotor 4 Propeller (Rear-Right: -X, -Y) -->
    <visual>
      <origin xyz="-0.22 -0.22 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.008"/>
      </geometry>
      <material name="prop_red">
        <color rgba="1.0 0.2 0.2 0.7"/>
      </material>
    </visual>

    <!-- Landing Skid Left -->
    <visual>
      <origin xyz="0 0.10 -0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.015 0.015"/>
      </geometry>
      <material name="skid_silver">
        <color rgba="0.75 0.75 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.10 -0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.015 0.015"/>
      </geometry>
    </collision>

    <!-- Landing Skid Right -->
    <visual>
      <origin xyz="0 -0.10 -0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.015 0.015"/>
      </geometry>
      <material name="skid_silver">
        <color rgba="0.75 0.75 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.10 -0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.015 0.015"/>
      </geometry>
    </collision>
  </link>
</robot>
