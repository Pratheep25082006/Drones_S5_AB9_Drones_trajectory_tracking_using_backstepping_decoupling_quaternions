<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="quadrotor_world">
    <!-- Sun Light Source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- GUI Camera Settings (Fixed Overview Perspective) -->
    <gui active="true">
      <camera name="user_camera">
        <pose>-4.0 -4.0 3.5 0 0.45 0.785</pose>
      </camera>
    </gui>



    <!-- Physics Configuration -->
    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>

      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <!-- Quadrotor Helicopter Model (Paper Benchmark Setup) -->
    <model name="quadrotor">
      <pose>0 0 0.2 0 0 0</pose>
      <static>false</static>

      <!-- Center Body Link -->
      <link name="base_link">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <inertial>

          <mass>1.5</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>0.03</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.03</iyy>
            <iyz>0.0</iyz>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <!-- Fuselage Core Visual -->
        <visual name="fuselage_visual">
          <geometry>
            <box>
              <size>0.22 0.22 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.15 0.2 1</ambient>
            <diffuse>0.15 0.25 0.35 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>

        <!-- Top Canopy Visual -->
        <visual name="canopy_visual">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.09</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.0 0.6 0.9 1</ambient>
            <diffuse>0.2 0.7 1.0 1</diffuse>
          </material>
        </visual>

        <!-- Nose Direction Indicator -->
        <visual name="nose_visual">
          <pose>0.14 0 0.02 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.2 0.2 1</ambient>
            <diffuse>1.0 0.3 0.3 1</diffuse>
          </material>
        </visual>

        <!-- Arm 1: Front-Right (+X, -Y) -->
        <visual name="arm1_visual">
          <pose>0.12 -0.12 0 0 0 -0.7854</pose>
          <geometry>
            <box>
              <size>0.28 0.03 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <!-- Motor 1 Base -->
        <visual name="motor1_visual">
          <pose>0.22 -0.22 0.02 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.4 1</ambient>
          </material>
        </visual>
        <!-- Rotor Disc 1 -->
        <visual name="rotor1_disc">
          <pose>0.22 -0.22 0.045 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.14</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.9 1.0 0.6</ambient>
            <diffuse>0.0 0.8 1.0 0.6</diffuse>
          </material>
        </visual>

        <!-- Arm 2: Front-Left (+X, +Y) -->
        <visual name="arm2_visual">
          <pose>0.12 0.12 0 0 0 0.7854</pose>
          <geometry>
            <box>
              <size>0.28 0.03 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <!-- Motor 2 Base -->
        <visual name="motor2_visual">
          <pose>0.22 0.22 0.02 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.4 1</ambient>
          </material>
        </visual>
        <!-- Rotor Disc 2 -->
        <visual name="rotor2_disc">
          <pose>0.22 0.22 0.045 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.14</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.9 1.0 0.6</ambient>
            <diffuse>0.0 0.8 1.0 0.6</diffuse>
          </material>
        </visual>

        <!-- Arm 3: Rear-Left (-X, +Y) -->
        <visual name="arm3_visual">
          <pose>-0.12 0.12 0 0 0 -0.7854</pose>
          <geometry>
            <box>
              <size>0.28 0.03 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <!-- Motor 3 Base -->
        <visual name="motor3_visual">
          <pose>-0.22 0.22 0.02 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.2 0.2 1</ambient>
          </material>
        </visual>
        <!-- Rotor Disc 3 -->
        <visual name="rotor3_disc">
          <pose>-0.22 0.22 0.045 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.14</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.2 0.4 0.6</ambient>
            <diffuse>1.0 0.2 0.4 0.6</diffuse>
          </material>
        </visual>

        <!-- Arm 4: Rear-Right (-X, -Y) -->
        <visual name="arm4_visual">
          <pose>-0.12 -0.12 0 0 0 0.7854</pose>
          <geometry>
            <box>
              <size>0.28 0.03 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <!-- Motor 4 Base -->
        <visual name="motor4_visual">
          <pose>-0.22 -0.22 0.02 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.2 0.2 1</ambient>
          </material>
        </visual>
        <!-- Rotor Disc 4 -->
        <visual name="rotor4_disc">
          <pose>-0.22 -0.22 0.045 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.14</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.2 0.4 0.6</ambient>
            <diffuse>1.0 0.2 0.4 0.6</diffuse>
          </material>
        </visual>

        <!-- Collision Body -->
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.12</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
